{
  "schema_version": 1,
  "purpose": "MATH SFT -> RSFT -> DPO -> GRPO configuration review",
  "execution_state": "review_not_launched",
  "seed": 42,
  "model": {
    "id": "Qwen/Qwen2.5-Math-1.5B",
    "initial_weights": "/root/autodl-tmp/models/Qwen2.5-Math-1.5B",
    "restart_from_base": true,
    "full_parameter_training": true
  },
  "dataset": {
    "id": "EleutherAI/hendrycks_math",
    "revision": "21a5633873b6a120296cce3e2df9d5550074f4a3",
    "path": "/root/autodl-tmp/hendrycks_math",
    "subjects": ["algebra", "counting_and_probability", "geometry", "intermediate_algebra", "number_theory", "prealgebra", "precalculus"],
    "validation_fraction": 0.1,
    "split_method": "deterministic_subject_level_stratified_problem_groups",
    "validation_generation_limit": 0,
    "test_generation_limit": 0,
    "gold_extraction": "extract_boxed_answer(solution)",
    "gold_parse_failure": "block_and_report",
    "duplicate_problem_policy": "keep_identical_problems_in_same_split",
    "train_test_overlap_policy": "exclude_training_side_and_report",
    "gold_repairs_file": "gold_repairs.json"
  },
  "prompt": {
    "mode": "user_r1_zero_only",
    "file": "prompts/user.txt",
    "apply_chat_template": false,
    "assistant_prefix_in_prompt": "Assistant: <think>",
    "response_template": "{solution}</think> <answer>{gold}</answer>",
    "teacher_forcing_eos": true,
    "rollout_eos": "only_if_actually_sampled"
  },
  "generation": {
    "temperature": 1.0,
    "top_p": 1.0,
    "top_k": -1,
    "max_new_tokens": 1024,
    "stop": ["</answer>"],
    "include_stop_str_in_output": true,
    "evaluation_samples_per_question": 1,
    "evaluation_min_tokens": 0,
    "rsft_dpo_min_tokens": 4,
    "grpo_min_tokens": 4
  },
  "grader": {
    "source": "../baseline/drgopo_grader.py",
    "function": "r1_zero_reward_fn",
    "fast": false,
    "primary_metric": "answer_reward_rate_including_format_failures",
    "report": ["answer_reward_rate", "format_reward_rate", "truncation_rate", "grader_timeout_rate", "grader_error_rate", "subject_level_accuracy"],
    "timeout_seconds": 5,
    "error_policy": "log_separately_exclude_from_training_labels_block_promotion_until_resolved"
  },
  "runtime": {
    "parameter_dtype": "float32",
    "autocast_dtype": "bfloat16",
    "attention": "sdpa",
    "gradient_checkpointing": true,
    "max_grad_norm": 1.0,
    "initial_max_sequence_length": 4096,
    "oversize_training_policy": "block_and_report_no_silent_truncation",
    "sampling_engine": "vllm",
    "sampling_gpu_memory_utilization": 0.85,
    "sampling_training_concurrent_gpu_residency": false,
    "initial_micro_batch": 1,
    "micro_batch_selection": "benchmark_1_2_4_8_on_longest_samples_before_launch",
    "minimum_free_gpu_gib": 6
  },
  "selection": {
    "eligible_checkpoints": "trained_stage_checkpoints_only",
    "primary": "full_validation_answer_reward_rate",
    "tie_breakers": ["lower_validation_response_mean_nll", "earlier_step"],
    "test_used_for_selection": false,
    "save_best_and_final": true,
    "initial_baseline_saved_separately": true,
    "fallback_to_input_if_stage_worse": false,
    "promotion_requirements": ["training_complete", "validation_complete", "test_complete", "grader_errors_resolved", "model_tokenizer_prompt_hashes_match"],
    "manifest": "artifacts/promotions.json"
  },
  "stages": {
    "sft": {
      "input": "model.initial_weights",
      "epochs": 3,
      "learning_rate": 0.00001,
      "effective_batch": 8,
      "warmup_ratio": 0.03,
      "weight_decay": 0.0,
      "loss_reduction": "response_token_mean_then_batch_mean",
      "validation_every_updates": 400,
      "save_every_updates": 200,
      "also_validate_final": true
    },
    "rsft": {
      "input": "sft.best_model",
      "sample_questions": "all_training_questions",
      "candidates_per_question": 8,
      "retain_per_question": 2,
      "deduplicate_response_text": true,
      "insufficient_candidates": "keep_available_no_duplication",
      "acceptance": "answer_reward=1 and format_reward=1 and not truncated",
      "epochs": 1,
      "learning_rate": 0.000005,
      "effective_batch": 8,
      "weight_decay": 0.0,
      "validation_every_updates": 400,
      "save_every_updates": 200,
      "also_validate_final": true
    },
    "dpo": {
      "input": "rsft.best_model",
      "reference": "frozen_exact_copy_of_rsft.best_model",
      "candidate_source": "fresh_sampling_from_rsft.best_model",
      "sample_questions": "all_training_questions",
      "candidates_per_question": 8,
      "pairs_per_question": 1,
      "chosen": "well_formed_complete_correct",
      "rejected": "well_formed_complete_nonempty_wrong_no_grader_errors",
      "missing_side": "skip_and_report_coverage",
      "cache_reference_log_probs": true,
      "beta": 0.1,
      "epochs": 1,
      "learning_rate": 0.000001,
      "effective_batch": 8,
      "warmup_ratio": 0.1,
      "sequence_log_prob_reduction": "sum",
      "validation_every_updates": 100,
      "save_every_updates": 50,
      "also_validate_final": true
    },
    "grpo": {
      "input": "dpo.best_model",
      "rollout_rounds": 200,
      "rollout_questions": 32,
      "group_size": 8,
      "epochs_per_rollout": 2,
      "learning_rate": 0.00001,
      "warmup_rounds": 0,
      "logical_train_batch_size": 8,
      "logical_gradient_accumulation_steps": 4,
      "effective_batch": 32,
      "optimizer_betas": [0.9, 0.95],
      "weight_decay": 0.0,
      "clip_eps": 0.2,
      "advantage": "reward_minus_group_mean",
      "advantage_eps": 0.000001,
      "advantage_eps_used": false,
      "loss_reduction": "token_sum_then_response_mean",
      "kl_beta": 0.0,
      "old_policy_refresh": "once_per_rollout_before_any_update",
      "min_tokens_distribution_handling": "suppress_eos_in_old_and_new_log_prob_normalization_for_first_4_sampled_tokens",
      "validation_rounds": [10, 50, 100, 150, 200],
      "save_every_rounds": 10
    }
  },
  "storage": {
    "results_root": "/root/autodl-fs/posttrain/math-20260912-r1",
    "optimizer_checkpoint_root": "/root/autodl-tmp/posttrain-math-resume",
    "retain_all_stage_best_models": true,
    "retain_all_stage_final_models": true,
    "optimizer_checkpoint_retention": "current_stage_only_after_verified_promotion",
    "overwrite_gsm8k_artifacts": false
  }
}
